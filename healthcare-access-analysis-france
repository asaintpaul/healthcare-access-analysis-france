    "    df_geo = df.merge(geo, left_on='code_insee', right_on='code_commune_insee', how='inner')\n",
    "    df_geo = df_geo.dropna(subset=['latitude', 'longitude', 'tps_smur'])\n",
    "    print(f\"Coordonnées récupérées pour {len(df_geo)} communes.\")\n",
    "\n",
    "except Exception as e:\n",
    "    print(f\"Erreur API Geo : {e}\")\n",
    "    df_geo = pd.DataFrame()"
