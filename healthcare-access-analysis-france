    "    '27': 'Bourgogne-Franche-Comté', '76': 'Occitanie', '32': 'Hauts-de-France',\n",
    "    '28': 'Normandie', '24': 'Centre-Val de Loire', '53': 'Bretagne',\n",
    "    '94': 'Corse', '11': 'Île-de-France', '52': 'Pays de la Loire',\n",
    "    '93': 'PACA', '01': 'Guadeloupe', '02': 'Martinique', '03': 'Guyane',\n",
