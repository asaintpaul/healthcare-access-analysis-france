    "import folium\n",
    "import numpy as np\n",
    "\n",
    "# Fonction de conversion Mercator -> Latitude/Longitude\n",
    "def mercator_to_latlon(x, y):\n",
    "    lon = (x / 20037508.34) * 180\n",
    "    lat = (y / 20037508.34) * 180\n",
    "    lat = 180 / np.pi * (2 * np.arctan(np.exp(lat * np.pi / 180)) - np.pi / 2)\n",
    "    return lat, lon\n",
    "\n",
    "# Vérification et calcul des coordonnées si nécessaire\n",
    "if 'latitude' not in df_hosp.columns and 'y_mercator' in df_hosp.columns:\n",
    "    print(\"Conversion des coordonnées Mercator en Latitude/Longitude...\")\n",
    "    df_hosp['latitude'], df_hosp['longitude'] = mercator_to_latlon(\n",
    "        df_hosp['x_mercator'].values, \n",
    "        df_hosp['y_mercator'].values\n",
    "    )\n",
    "\n",
    "# Création de la carte\n",
    "map_hosp = folium.Map(location=[46.603354, 1.888334], zoom_start=6)\n",
    "\n",
    "# Ajout des marqueurs\n",
    "for idx, row in df_hosp.iterrows():\n",
    "    if not np.isnan(row['latitude']) and not np.isnan(row['longitude']):\n",
    "        folium.CircleMarker(\n",
    "            location=[row['latitude'], row['longitude']],\n",
    "            radius=3,\n",
    "            color='darkblue',\n",
    "            fill=True,\n",
    "            fill_color='darkblue',\n",
    "            fill_opacity=0.8,\n",
    "            popup=f\"Hôpital : {row.get('identifiant', idx)}\"\n",
    "        ).add_to(map_hosp)\n",
    "\n",
    "map_hosp"
   ]
