    "if not df_geo.empty:\n",
    "    print(\"Génération de la carte...\")\n",
    "    m = folium.Map(location=[46.603354, 1.888334], zoom_start=6, tiles='cartodbpositron')\n",
    "\n",
    "    # Couche Hôpitaux\n",
    "    fg_hop = folium.FeatureGroup(name=\"Hôpitaux\")\n",
    "    cluster = MarkerCluster().add_to(fg_hop)\n",
    "    for _, row in hop.iterrows():\n",
    "        if pd.notna(row['latitude']) and pd.notna(row['longitude']):\n",
    "            folium.Marker([row['latitude'], row['longitude']], popup=row['nom'],\n",
    "                          icon=folium.Icon(color='blue', icon='plus', prefix='fa')).add_to(cluster)\n",
    "    fg_hop.add_to(m)\n",
    "\n",
    "    # Couche Heatmap Temps d'accès\n",
    "    fg_heat = folium.FeatureGroup(name=\"Chaleur (Temps Accès)\")\n",
    "    heat_data = df_geo[['latitude', 'longitude', 'tps_smur']].values.tolist()\n",
    "    HeatMap(heat_data, min_opacity=0.4, radius=15, blur=10,\n",
    "            gradient={0.2: 'blue', 0.4: 'yellow', 0.6: 'orange', 1: 'red'}).add_to(fg_heat)\n",
    "    fg_heat.add_to(m)\n",
    "\n",
    "    folium.LayerControl(collapsed=False).add_to(m)\n",
    "    m.save('carte_acces_soins.html')\n",
    "    print(\"Carte sauvegardée : carte_acces_soins.html\")\n",
    "    display(m)\n",
    "else:\n",
    "    print(\"Pas de données géographiques pour la carte.\")"
