    "print(\"Récupération des coordonnées géographiques...\")\n",
    "url_api = 'https://geo.api.gouv.fr/communes?fields=code,centre&format=json&geometry=centre'\n",
    "\n",
    "try:\n",
    "    data = requests.get(url_api).json()\n",
    "    geo = pd.json_normalize(data)\n",
    "    geo['longitude'] = geo['centre.coordinates'].apply(lambda x: x[0] if isinstance(x, list) else None)\n",
